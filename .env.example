# Copie para .env e preencha. Nunca versione o .env.
# Todas as variáveis são opcionais: fontes sem credencial ficam registradas como bloqueadas.

# OpenAI (projeto dedicado, chave de serviço; limites também em config/raven.yaml > budgets)
RAVEN_OPENAI_API_KEY=

# YouTube Data API v3 — chave RESTRITA à YouTube Data API (Google Cloud > Credenciais)
RAVEN_YOUTUBE_API_KEY=

# DataForSEO — login e senha de API em https://app.dataforseo.com/api-access
RAVEN_DATAFORSEO_LOGIN=
RAVEN_DATAFORSEO_PASSWORD=

# OutlierKit — chave criada em https://outlierkit.com/app/api (plano com acesso à API)
RAVEN_OUTLIERKIT_API_KEY=

# vidIQ — chave somente-leitura em app.vidiq.com > Account Settings > MCP
RAVEN_VIDIQ_API_KEY=

# Telegram (Fase 2)
RAVEN_TELEGRAM_BOT_TOKEN=
RAVEN_TELEGRAM_CHAT_ID=

# Diretórios (padrão: ./data e ./config)
# RAVEN_DATA_DIR=/srv/raven/data
# RAVEN_CONFIG_DIR=/srv/raven/config
